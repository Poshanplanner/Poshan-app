rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read only their own record. Only the server (payment API) can write,
    // so nobody can give themselves Pro from the browser.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
